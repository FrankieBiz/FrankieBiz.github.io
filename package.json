{
  "name": "frankie-bisignano-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Launch-to-orbit WebGL portfolio for Frankie Bisignano.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "node scripts/qa-shots.mjs",
    "assets": "node scripts/build-assets.mjs",
    "assets:fetch": "node scripts/fetch-nasa.mjs",
    "assets:grade": "uv run --quiet tools/lut/make_lut.py && uv run --quiet tools/textures/lens_dirt.py"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
